<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Clipped Video Viewport (supports smooth up to 8x zoom & pan) -->
    <FrameLayout
        android:id="@+id/videoViewport"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToPadding="true">

        <!-- LibVLC Video & Subtitle Surface (TextureView mode for zoom/pan & clean screenshots) -->
        <org.videolan.libvlc.util.VLCVideoLayout
            android:id="@+id/vlcVideoLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Gesture Capture Layer -->
    <View
        android:id="@+id/gestureOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- Screenshot Shutter Flash -->
    <View
        android:id="@+id/viewShutterFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/white"
        android:visibility="gone" />

    <!-- Buffering / Loading Indicator -->
    <LinearLayout
        android:id="@+id/layoutBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_osd_pill"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent_cyan" />

        <TextView
            android:id="@+id/tvBuffering"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/loading_video"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Gesture OSD Pill (Brightness / Volume / Seek / Aspect Ratio / Screenshot) -->
    <LinearLayout
        android:id="@+id/layoutOsd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_osd_pill"
        android:gravity="center"
        android:minWidth="160dp"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivOsdIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_volume"
                app:tint="@color/accent_cyan" />

            <TextView
                android:id="@+id/tvOsdPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOsdSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+00:10"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pbOsd"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="140dp"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/accent_cyan"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2.0x Long-Press Speed Pill -->
    <TextView
        android:id="@+id/tvSpeedBoostBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_osd_pill"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:text="⏩ 2.0x"
        android:textColor="@color/accent_cyan"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Zoom Mode Status Pill (Top Center) -->
    <TextView
        android:id="@+id/tvZoomStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_osd_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="🔍 ЗУМ 1.0x • жесты отключены"
        android:textColor="@color/accent_cyan"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Double-Tap Left/Right Indicators -->
    <TextView
        android:id="@+id/tvDoubleTapLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="42dp"
        android:background="@drawable/bg_osd_pill"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:text="⏪ -10с"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvDoubleTapRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="42dp"
        android:background="@drawable/bg_osd_pill"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:text="+10с ⏩"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Error Overlay -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_osd_pill"
        android:gravity="center"
        android:maxWidth="320dp"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/error_playback"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnErrorClose"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnErrorRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/retry" />
        </LinearLayout>
    </LinearLayout>

    <!-- NORMAL HUD CONTROLS OVERLAY -->
    <FrameLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_gradient_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingTop="14dp"
            android:paddingBottom="18dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVideoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="ALEXVID"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStreamBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ОНЛАЙН ПОТОК"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="1.0x"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSleepTimer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sleep_timer_title"
                android:src="@drawable/ic_timer" />

            <ImageButton
                android:id="@+id/btnPip"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="PiP"
                android:src="@drawable/ic_pip" />

            <ImageButton
                android:id="@+id/btnRotate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Rotate"
                android:src="@drawable/ic_rotate" />
        </LinearLayout>

        <!-- CENTER TRANSPORT CONTROLS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrevVideo"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:src="@drawable/ic_skip_prev"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_osd_pill"
                android:contentDescription="-10s"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_replay_10" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_osd_pill"
                android:contentDescription="Play/Pause"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_osd_pill"
                android:contentDescription="+10s"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_forward_10" />

            <ImageButton
                android:id="@+id/btnNextVideo"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:src="@drawable/ic_skip_next"
                android:visibility="gone" />
        </LinearLayout>

        <!-- BOTTOM BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_gradient_bottom"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <!-- Timeline Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:text="00:00"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="@color/accent_cyan"
                    android:thumbTint="@color/accent_cyan" />

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="52dp"
                    android:text="00:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Action Controls Row (Horizontally scrollable on narrow screens) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnLock"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Lock"
                        android:src="@drawable/ic_lock" />

                    <ImageButton
                        android:id="@+id/btnScreenshot"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Screenshot"
                        android:src="@drawable/ic_screenshot" />

                    <ImageButton
                        android:id="@+id/btnZoomMode"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Zoom mode"
                        android:src="@drawable/ic_zoom_in"
                        app:tint="@color/accent_cyan" />

                    <ImageButton
                        android:id="@+id/btnFrameMode"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Frame by frame"
                        android:src="@drawable/ic_frame_mode" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnSubtitles"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginHorizontal="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/subtitles_title"
                        android:src="@drawable/ic_subtitles" />

                    <ImageButton
                        android:id="@+id/btnAudioTrack"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginHorizontal="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/audio_tracks_title"
                        android:src="@drawable/ic_audio_track" />

                    <ImageButton
                        android:id="@+id/btnRepeat"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginHorizontal="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Repeat"
                        android:src="@drawable/ic_repeat" />

                    <ImageButton
                        android:id="@+id/btnAspectRatio"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Aspect ratio"
                        android:src="@drawable/ic_aspect_ratio" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- FILM REVIEW / ZOOM & FRAME-BY-FRAME BAR -->
    <LinearLayout
        android:id="@+id/layoutReviewBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_osd_pill"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <!-- Row 1: Mode Title, Timecode (ms) + FPS, Zoom Controls, Screenshot, Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReviewTimecode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="00:00.000 • 24 fps"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Zoom quick controls -->
            <LinearLayout
                android:id="@+id/layoutZoomButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnZoomOut"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnZoomReset"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="1.0x"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnZoomIn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnReviewToggleZoom"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle Zoom Mode"
                android:src="@drawable/ic_zoom_in" />

            <ImageButton
                android:id="@+id/btnReviewScreenshot"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Screenshot"
                android:src="@drawable/ic_screenshot"
                app:tint="@color/accent_cyan" />

            <ImageButton
                android:id="@+id/btnReviewClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Row 2: Frame-by-Frame Stepping Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnStepMinus1s"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="-1с"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnFramePrev"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_frame_prev"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="−1 кадр"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnReviewPlayPause"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_badge"
                android:contentDescription="Play/Pause"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="@color/accent_cyan" />

            <LinearLayout
                android:id="@+id/btnFrameNext"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="+1 кадр"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_frame_next"
                    app:tint="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnStepPlus1s"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="+1с"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- UNLOCK FLOATING BUTTON (Visible only when locked) -->
    <ImageButton
        android:id="@+id/btnUnlock"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="18dp"
        android:background="@drawable/bg_osd_pill"
        android:contentDescription="Unlock"
        android:padding="12dp"
        android:src="@drawable/ic_unlock"
        android:visibility="gone"
        app:tint="@color/accent_cyan" />

</FrameLayout>
